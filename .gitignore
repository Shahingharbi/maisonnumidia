# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# google service account credentials — NEVER commit
.credentials/
credentials.json
*-credentials.json
google-indexing.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# recherche de prix concurrents : données brutes et résultats générés (non versionnés)
scripts/_price-research/**/*.json
scripts/_price-research/raw2/
scripts/_price-research/web/
scripts/_price-research/*.html
scripts/_price-research/report-data.js

# audit des fiches produit : données de travail et résultats (non versionnés)
scripts/_catalog-audit/results/
scripts/_catalog-audit/*.json
